#!/usr/bin/env bash
# Regenerates assets/agentd.icns from scripts/icon.swift.
set -euo pipefail
cd "$(dirname "$0")/.."

work=$(mktemp -d "${TMPDIR:-/tmp}/agentd-icon.XXXXXX")
trap 'rm -rf "$work"' EXIT
swift scripts/icon.swift "$work/icon.png"
iconset="$work/agentd.iconset"
mkdir "$iconset"
for points in 16 32 128 256 512; do
  sips -z "$points" "$points" "$work/icon.png" --out "$iconset/icon_${points}x${points}.png" &>/dev/null
  double=$((points * 2))
  sips -z "$double" "$double" "$work/icon.png" --out "$iconset/icon_${points}x${points}@2x.png" &>/dev/null
done
iconutil -c icns "$iconset" -o assets/agentd.icns
