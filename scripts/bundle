#!/usr/bin/env bash
# Builds a release and assembles a signed target/release/Benches.app without installing it.
# BENCHES_VERSION overrides the bundle version, which defaults to Cargo.toml's.
# Set MAC_APP_SIGN to a codesigning identity; without it the bundle is signed ad hoc.
set -euo pipefail
cd "$(dirname "$0")/.."

cargo build --release --locked
version=${BENCHES_VERSION:-$(cargo metadata --no-deps --format-version 1 --locked |
  python3 -c 'import json, sys; print(next(p["version"] for p in json.load(sys.stdin)["packages"] if p["name"] == "benches"))')}

app=target/release/Benches.app
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp target/release/benches "$app/Contents/MacOS/Benches"
cp assets/benches.icns "$app/Contents/Resources/icon.icns"
# The standard About panel shows Credits.html, which carries the third-party notices.
cargo about generate --locked --fail about.hbs -o "$app/Contents/Resources/Credits.html"
# macOS looks entries up in a hashed directory, so compile rather than copy a source file.
tic -x -o "$app/Contents/Resources/terminfo" assets/xterm-ghostty.terminfo
cat >"$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Benches</string>
  <key>CFBundleDisplayName</key><string>Benches</string>
  <key>CFBundleIdentifier</key><string>dev.dewet.benches</string>
  <key>CFBundleExecutable</key><string>Benches</string>
  <key>CFBundleIconFile</key><string>icon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$version</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- Programs in a tab answer to macOS as Benches, which can only ask on their behalf with these. -->
  <key>NSAppleEventsUsageDescription</key><string>A program running within Benches would like to use AppleScript.</string>
  <key>NSBluetoothAlwaysUsageDescription</key><string>A program running within Benches would like to use Bluetooth.</string>
  <key>NSCalendarsUsageDescription</key><string>A program running within Benches would like to access your Calendar.</string>
  <key>NSCameraUsageDescription</key><string>A program running within Benches would like to use the camera.</string>
  <key>NSContactsUsageDescription</key><string>A program running within Benches would like to access your Contacts.</string>
  <key>NSLocalNetworkUsageDescription</key><string>A program running within Benches would like to access the local network.</string>
  <key>NSLocationUsageDescription</key><string>A program running within Benches would like to access your location information.</string>
  <key>NSMicrophoneUsageDescription</key><string>A program running within Benches would like to use your microphone.</string>
  <key>NSMotionUsageDescription</key><string>A program running within Benches would like to access motion data.</string>
  <key>NSPhotoLibraryUsageDescription</key><string>A program running within Benches would like to access your Photo Library.</string>
  <key>NSRemindersUsageDescription</key><string>A program running within Benches would like to access your reminders.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>A program running within Benches would like to use speech recognition.</string>
  <key>NSSystemAdministrationUsageDescription</key><string>A program running within Benches requires elevated privileges.</string>
</dict>
</plist>
EOF
plutil -lint "$app/Contents/Info.plist" >/dev/null
codesign --force --sign "${MAC_APP_SIGN:--}" "$app"
echo "$app"
