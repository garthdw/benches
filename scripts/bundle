#!/usr/bin/env bash
# Builds a release and assembles a signed target/release/agentd.app without installing it.
# AGENTD_VERSION overrides the bundle version, which defaults to Cargo.toml's.
# Set MAC_APP_SIGN to a codesigning identity; without it the bundle is signed ad hoc.
set -euo pipefail
cd "$(dirname "$0")/.."

cargo build --release --locked
version=${AGENTD_VERSION:-$(cargo metadata --no-deps --format-version 1 --locked |
  python3 -c 'import json, sys; print(json.load(sys.stdin)["packages"][0]["version"])')}

app=target/release/agentd.app
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp target/release/agentd "$app/Contents/MacOS/agentd"
cp assets/agentd.icns "$app/Contents/Resources/icon.icns"
# macOS looks entries up in a hashed directory, so compile rather than copy a source file.
tic -x -o "$app/Contents/Resources/terminfo" assets/xterm-ghostty.terminfo
cat >"$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>agentd</string>
  <key>CFBundleDisplayName</key><string>agentd</string>
  <key>CFBundleIdentifier</key><string>dev.dewet.agentd</string>
  <key>CFBundleExecutable</key><string>agentd</string>
  <key>CFBundleIconFile</key><string>icon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$version</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
EOF
plutil -lint "$app/Contents/Info.plist" >/dev/null
codesign --force --sign "${MAC_APP_SIGN:--}" "$app"
echo "$app"
