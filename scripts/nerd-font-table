#!/usr/bin/env python3
"""Regenerate crates/benches-font/src/nerd_font_table.rs from Ghostty's generated
src/font/nerd_font_tables.zig.

Usage: scripts/nerd-font-table PATH/TO/ghostty/src/font/nerd_font_tables.zig

libghostty-vt's build leaves a Ghostty checkout in
target/*/build/libghostty-vt-sys-*/out/ghostty-src. Run `cargo fmt` afterwards.
"""
import re
import sys
from pathlib import Path

SIZES = {"none": "None", "fit": "Fit", "cover": "Cover", "fit_cover1": "FitCover", "stretch": "Stretch"}
ALIGNS = {"none": "None", "start": "Start", "end": "End", "center1": "CenterFirst"}
NUMBERS = {
    "pad_top", "pad_left", "pad_right", "pad_bottom",
    "relative_width", "relative_height", "relative_x", "relative_y",
}


def array(source, name):
    body = re.search(rf"pub const {name}: \[\d+\]u16 = \.\{{(.*?)\}};", source, re.S).group(1)
    return [int(value) for value in body.split(",") if value.strip()]


def constraint(entry):
    fields = []
    for line in entry.strip().splitlines():
        match = re.match(r"\s*\.(\w+) = (.+),$", line)
        if not match:
            continue
        name, value = match.groups()
        if name == "size":
            fields.append(f"size: Size::{SIZES[value[1:]]}")
        elif name == "height":
            fields.append(f"icon_height: {str(value == '.icon').lower()}")
        elif name in ("align_horizontal", "align_vertical"):
            fields.append(f"{name}: Align::{ALIGNS[value[1:]]}")
        elif name == "max_xy_ratio":
            fields.append(f"max_xy_ratio: Some({float(value)!r})")
        elif name == "max_constraint_width":
            fields.append(f"max_constraint_width: {value}")
        elif name in NUMBERS:
            fields.append(f"{name}: {float(value)!r}")
        else:
            sys.exit(f"unknown constraint field {name}")
    return "Constraint { " + ", ".join(fields) + ", ..Constraint::NONE }"


def main(path):
    source = Path(path).read_text()
    stage1, stage2 = array(source, "stage1"), array(source, "stage2")
    stage3 = re.search(r"pub const stage3: \[\d+\]Elem = \.\{\n(.*)\n        \};", source, re.S).group(1)
    entries = re.findall(r"\.\{\n(.*?)\n            \}", stage3, re.S)

    ranges = []
    for page, offset in enumerate(stage1):
        if offset == 0:
            continue
        for low in range(256):
            index = stage2[offset + low]
            if index == 0:
                continue
            codepoint = page * 256 + low
            if ranges and ranges[-1][1] + 1 == codepoint and ranges[-1][2] == index - 1:
                ranges[-1][1] = codepoint
            else:
                ranges.append([codepoint, codepoint, index - 1])

    out = [
        "//! Generated by scripts/nerd-font-table from Ghostty's nerd_font_tables.zig. Do not edit.",
        "//! Ghostty (MIT, © Mitchell Hashimoto, Ghostty contributors).",
        "",
        "use crate::constraint::{Align, Constraint, Size};",
        "",
        "#[rustfmt::skip]",
        f"pub(crate) static RANGES: [(u32, u32, u16); {len(ranges)}] = [",
        *[f"    (0x{start:X}, 0x{end:X}, {index})," for start, end, index in ranges],
        "];",
        "",
        "#[rustfmt::skip]",
        f"pub(crate) static CONSTRAINTS: [Constraint; {len(entries)}] = [",
        *[f"    {constraint(entry)}," for entry in entries],
        "];",
        "",
    ]
    target = Path(__file__).resolve().parent.parent / "crates/benches-font/src/nerd_font_table.rs"
    target.write_text("\n".join(out))


main(sys.argv[1])
